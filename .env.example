# =============================================================================
# Lekkr – Umgebungsvariablen (Kopie nach `.env`, Werte aus Dashboards eintragen)
# =============================================================================
# Niemals echte Secrets committen. Service-Role nur auf dem Server (Netlify).
#
# Netlify (lekkr.netlify.app): .env wird NICHT deployed. Alle VITE_* unten im Dashboard
# unter Site → Environment variables eintragen und neu deployen (Clear cache + deploy),
# sonst fehlen Supabase/Tenant im gebauten Bundle.
# =============================================================================

# --- Supabase (Projekt → Settings → API) ---
# Region z. B. Frankfurt: eu-central-1
VITE_SUPABASE_URL=https://xxxx.supabase.co
# Für Netlify Functions (gleiche URL wie oben)
SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Öffentliche Site-URL (lokal: http://localhost:5173, Prod: https://lekkr.ai)
# Für OAuth/Magic-Link Redirects in Supabase unter Authentication → URL Configuration eintragen.
VITE_PUBLIC_SITE_URL=http://localhost:5173

# Standard-Tenant für Domain-Mapping / lokale Entwicklung (UUID aus public.tenants)
VITE_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# --- Stripe (Zahlungen) ---
# Nur publishable im Frontend (VITE_*)
VITE_STRIPE_PUBLIC_KEY=pk_test_...

# Nur Netlify Functions / Server (niemals VITE_*)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- E-Mail (Resend) – Bestellbestätigung, Willkommen, DOI, Geburtstag, Inaktivität ---
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=orders@deinedomain.de

# --- SMS (Twilio) – notify-customer (Abholbereit / Fahrer unterwegs) ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+491234567890

# --- helloCash (Kasse / Rechnungen, nur Netlify Functions) ---
# Basis-URL laut helloCash-Dokumentation (ohne trailing slash)
HELLOCASH_API_BASE_URL=https://api.hellocash.at
HELLOCASH_API_KEY=...
# Optional: Pfade überschreiben (Defaults: /v1/invoices, /v1/inventory/movements)
# HELLOCASH_INVOICE_PATH=/v1/invoices
# HELLOCASH_STOCK_PATH=/v1/inventory/movements

# --- Supabase Service Role (nur Backend: Migrationen, Webhooks, Admin-Jobs) ---
# Nicht ins Frontend, nicht mit VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Optional: Netlify / CI ---
# NODE_VERSION=22
